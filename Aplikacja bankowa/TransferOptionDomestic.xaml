<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionDomestic">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Przelew krajowy"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}">
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryRecipientsAccount"
                            Keyboard="Numeric"
                            Placeholder="Podaj rachunek odbiorcy"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryRecipientNameAndSurname"
                            Keyboard="Text"
                            Placeholder="Podaj imię i nazwisko odbiorcy"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryTransferReference"
                            Keyboard="Text"
                            Placeholder="Podaj tytuł przelewu"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryTransferAmount"
                            Keyboard="Numeric"
                            Placeholder="Podaj kwotę przelewu"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <VerticalStackLayout>
                            <Label
                                Text="Podaj datę przelewu"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                            <DatePicker
                                x:Name="DatePickerDateOfTransfer"
                                Format="dd.MM.yyyy"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                BackgroundColor="#cdcdcd"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <VerticalStackLayout>
                            <Label
                                Text="Wybierz typ przelewu"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                            <RadioButton
                                x:Name="RadioButtonStandard"
                                Content="Standardowy"
                                IsChecked="True">
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioButtonBlueCash"
                                Content="BlueCash">
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioButtonExpressElixir"
                                Content="Express Elixir">
                            </RadioButton>
                        </VerticalStackLayout>
                    </Border>

                    <Button
                        Text="Przelej"
                        HorizontalOptions="Center"
                        FontSize="25"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonTransferClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>