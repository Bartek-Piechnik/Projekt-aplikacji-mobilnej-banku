<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MenuPage">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Zarządzaj"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}"
                    BackgroundColor="#eeeeee">
                <VerticalStackLayout Padding="0, 0, 0, 10">
                    <Button
                        Text="Moje dane"
                        FontSize="25"
                        Margin="15, 20, 15, 0"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonGoToMyDataPageClicked" />
                    <Button
                        Text="Zmiana hasła"
                        FontSize="25"
                        Margin="15, 20, 15, 0"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonGoToChangePasswordPageClicked" />
                    <Button
                        Text="Limity płatności"
                        FontSize="25"
                        Margin="15, 20, 15, 0"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonGoToPaymentLimitsPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>