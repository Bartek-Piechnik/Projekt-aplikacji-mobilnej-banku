<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionPhone"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Przelew BLIK na telefon" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Numer telefonu odbiorcy"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryRecipientsPhoneNumber"
                            Keyboard="Telephone"
                            Placeholder="Podaj numer telefonu odbiorcy" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Tytuł przelewu"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryTransferReference"
                            Keyboard="Text"
                            Placeholder="Podaj tytuł przelewu"
                            Text="{Binding Item.TransferTitle}" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Kwota przelewu"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryTransferAmount"
                            Keyboard="Numeric"
                            Placeholder="Podaj kwotę przelewu"
                            Text="{Binding Item.TransferAmount}" />
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonTransfer"
                        Text="Przelej"
                        HorizontalOptions="Center"
                        Clicked="OnButtonTransferClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>