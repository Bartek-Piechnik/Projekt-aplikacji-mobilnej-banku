<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.ChangePasswordPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zmień hasło" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Stare hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryOldPassword"
                                Keyboard="Text"
                                Placeholder="Podaj stare hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityOldPassword"
                                Clicked="OnButtonChangeVisibilityOldPasswordClicked" />
                        </Grid>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Nowe hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryNewPassword"
                                Keyboard="Text"
                                Placeholder="Podaj nowe hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityNewPassword"
                                Clicked="OnButtonChangeVisibilityNewPasswordClicked" />
                        </Grid>
                    </Border>
                    
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Powtórzone nowe hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryRepeatedNewPassword"
                                Keyboard="Text"
                                Placeholder="Powtórz nowe hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityRepeatedNewPassword"
                                Clicked="OnButtonChangeVisibilityRepeatedNewPasswordClicked" />
                        </Grid>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Text="Zmień hasło"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>