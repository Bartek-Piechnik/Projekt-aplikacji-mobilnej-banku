<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zaloguj się" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Keyboard="Email"
                            Placeholder="Podaj adres e-mail" />
                    </Border>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPassword"
                            Keyboard="Password"
                            Placeholder="Podaj hasło" />
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        Text="Zaloguj"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMainViewPageClicked" />
                    <Button
                        Style="{StaticResource Button}"
                        Text="Nie masz konta ? Zarejestruj się"
                        HorizontalOptions="End"
                        FontAttributes="Italic"
                        FontSize="12"
                        TextColor="#388e3c"
                        BackgroundColor="Transparent"
                        Clicked="OnButtonGoToRegisterPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>