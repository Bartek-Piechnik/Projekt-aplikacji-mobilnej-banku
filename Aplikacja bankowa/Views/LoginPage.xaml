<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zaloguj się" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Adres e-mail"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Keyboard="Email"
                            Placeholder="Podaj adres e-mail" />
                    </Border>
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryPassword"
                                Keyboard="Text"
                                Placeholder="Podaj hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityPassword"
                                Clicked="OnButtonChangeVisibilityPasswordClicked" />
                        </Grid>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMainViewPage"
                        Text="Zaloguj"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMainViewPageClicked" />
                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToRegisterPage"
                        Text="Nie masz konta ? Zarejestruj się"
                        HorizontalOptions="End"
                        FontAttributes="Italic"
                        FontSize="12"
                        TextColor="#388e3c"
                        BackgroundColor="Transparent"
                        Clicked="OnButtonGoToRegisterPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>