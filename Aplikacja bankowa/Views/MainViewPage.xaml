<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MainViewPage"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout BackgroundColor="#dedede">
            <VerticalStackLayout>
                <Grid
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Margin="10, 5, 10, 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonLogOut"
                        Grid.Column="0"
                        Grid.Row="0"
                        ImageSource="logout.png"
                        HeightRequest="50"
                        WidthRequest="120"
                        HorizontalOptions="Start"
                        Clicked="OnButtonLogOutClicked" />
                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Grid.Column="1"
                        Grid.Row="0"
                        ImageSource="menu.png"
                        HeightRequest="50"
                        WidthRequest="120"
                        HorizontalOptions="End"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </Grid>

                <AbsoluteLayout
                    Margin="15"
                    HeightRequest="200">
                    <BoxView
                        BackgroundColor="#8bc34a"
                        CornerRadius="20"
                        AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                        AbsoluteLayout.LayoutFlags="All" />
                    <Label
                        Text="Rachunek bieżący"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.03, 220, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        x:Name="LabelRecipientsAccount"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.2, 0.22, 300, 20"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="Dostępne środki"
                        TextColor="White"
                        FontSize="25"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.6, 250, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        x:Name="LabelAvailableFunds"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.1, 0.77, 250, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Button
                        Style="{StaticResource Button}"
                        x:Name="BlockUnblockCardButton"
                        ImageSource="credit_card_on.png"
                        WidthRequest="70"
                        HeightRequest="70"
                        AbsoluteLayout.LayoutBounds="0.95, 0.75, 70, 70"
                        AbsoluteLayout.LayoutFlags="PositionProportional" 
                        Clicked="OnButtonBlockUnblockCardClicked"/>
                </AbsoluteLayout>
            </VerticalStackLayout>

            <Border
                Style="{StaticResource BorderWhiteSection}"
                Margin="10,0,10,0"
                StrokeThickness="0">
                <VerticalStackLayout BackgroundColor="White">
                    <Button
                        x:Name="ButtonGoToHistoryPage"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Text="Historia transakcji >"
                        FontSize="23"
                        TextColor="Black"
                        FontAttributes="Bold"
                        Clicked="OnButtonGoToHistoryPageClicked"/>
                    <CollectionView
                        ItemsSource="{Binding Transactions}"
                        ItemTemplate="{StaticResource TransactionTemplate}"
                        SelectionMode="None"
                        Margin="15" />
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource BorderWhiteSection}"
                Margin="10, 20, 10, 20"
                StrokeThickness="0">
                <VerticalStackLayout BackgroundColor="White">
                    <Label
                        Style="{StaticResource LabelForm}"
                        Text="Opcje przelewu"
                        FontSize="20"
                        HorizontalTextAlignment="Center">
                    </Label>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        Margin="0, 5, 0, 10">
                        <Button
                            Style="{StaticResource Button}"
                            x:Name="ButtonGoToTransferOptionBLIK"
                            Text="BLIK"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionBLIKClicked" />
                        <Button
                            Style="{StaticResource Button}"
                            x:Name="ButtonGoToTransferOptionDomestic"
                            Text="Krajowy"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionDomesticClicked" />
                        <Button
                            Style="{StaticResource Button}"
                            x:Name="ButtonGoToTransferOptionPhone"
                            Text="Telefon"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionPhoneClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>