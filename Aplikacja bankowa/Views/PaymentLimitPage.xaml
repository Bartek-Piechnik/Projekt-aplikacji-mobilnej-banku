<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.PaymentLimitPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zmień limit płatności" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryMaxAmount"
                            Keyboard="Numeric"
                            Placeholder="Podaj maksymalną kwotę" />
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Text="Zmień limit płatności"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>