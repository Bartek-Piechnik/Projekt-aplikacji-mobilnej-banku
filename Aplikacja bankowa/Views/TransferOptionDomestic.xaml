<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionDomestic"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Przelew krajowy" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryRecipientsAccount"
                            Keyboard="Numeric"
                            Placeholder="Podaj rachunek odbiorcy" 
                            Text="{Binding Item.RecipientsAccount}"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryRecipientNameAndSurname"
                            Keyboard="Text"
                            Placeholder="Podaj imię i nazwisko odbiorcy" 
                            Text="{Binding Item.RecipientNameAndSurname}"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryTransferReference"
                            Keyboard="Text"
                            Placeholder="Podaj tytuł przelewu" 
                            Text="{Binding Item.TransferReference}"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryTransferAmount"
                            Keyboard="Numeric"
                            Placeholder="Podaj kwotę przelewu" 
                            Text="{Binding Item.TransferAmount}"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <VerticalStackLayout>
                            <Label
                                Style="{StaticResource LabelForm}"
                                Text="Podaj datę przelewu"
                                HorizontalTextAlignment="Center"
                                FontSize="15" />
                            <DatePicker
                                Style="{StaticResource DatePickerForm}"
                                x:Name="DatePickerDateOfTransfer" 
                                Date="{Binding Item.DateOfTransfer}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <VerticalStackLayout>
                            <Label
                                Style="{StaticResource LabelForm}"
                                Text="Wybierz typ przelewu"
                                HorizontalTextAlignment="Center"
                                FontSize="15" />
                            <RadioButton
                                x:Name="RadioButtonStandard"
                                Content="Standardowy"
                                CheckedChanged="OnTransferTypeChanged"
                                TextColor="Black">
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioButtonBlueCash"
                                Content="BlueCash"
                                CheckedChanged="OnTransferTypeChanged"
                                TextColor="Black">
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioButtonExpressElixir"
                                Content="Express Elixir"
                                CheckedChanged="OnTransferTypeChanged"
                                TextColor="Black">
                            </RadioButton>
                        </VerticalStackLayout>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonTransfer"
                        Text="Przelej"
                        HorizontalOptions="Center"
                        Clicked="OnButtonTransferClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>