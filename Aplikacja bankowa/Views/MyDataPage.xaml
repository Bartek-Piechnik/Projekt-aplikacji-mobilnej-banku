<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MyDataPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}"
                                     Padding="5">
                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Imię"
                            HorizontalTextAlignment="Center"
                            Padding="15" />
                        <Border Style="{StaticResource BorderEntry}">
                            <Entry
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryName"
                                Text="" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Nazwisko"
                            HorizontalTextAlignment="Center"
                            Padding="15" />
                        <Border Style="{StaticResource BorderEntry}">
                            <Entry
                                Style="{StaticResource EntryForm}"
                                x:Name="EntrySurname"
                                Text="" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Data urodzenia"
                            HorizontalTextAlignment="Center"
                            Padding="15" />
                        <Border Style="{StaticResource BorderEntry}">
                            <DatePicker
                                Style="{StaticResource DatePickerForm}"
                                x:Name="DatePickerDateOfBirth" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Adres e-mail"
                            HorizontalTextAlignment="Center"
                            Padding="15" />
                        <Border Style="{StaticResource BorderEntry}">
                            <Entry
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryEmail"
                                Text="" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Numer telefonu"
                            HorizontalTextAlignment="Center"
                            Padding="15" />
                        <Border Style="{StaticResource BorderEntry}">
                            <Entry
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryPhoneNumber"
                                Text="" />
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Text="Zmień"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>