<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MyDataPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zmień moje dane" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}"
                                     Padding="5">
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Imię" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryName"
                            Placeholder="Podaj imię"
                            Text="" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Nazwisko" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntrySurname"
                            Placeholder="Podaj nazwisko"
                            Text="" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Data urodzenia" />
                    <Border Style="{StaticResource BorderEntry}">
                        <DatePicker
                            Style="{StaticResource DatePickerForm}"
                            x:Name="DatePickerDateOfBirth" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Adres e-mail" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Placeholder="Podaj adres e-mail"
                            Text="" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Numer telefonu" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPhoneNumber"
                            Placeholder="Podaj numer telefonu"
                            Text="" />
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Text="Zmień"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>