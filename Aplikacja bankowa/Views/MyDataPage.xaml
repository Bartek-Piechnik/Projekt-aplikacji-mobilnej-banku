<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MyDataPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zmień moje dane" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}"
                                     Padding="5">
                    <AbsoluteLayout
                        Margin="5"
                        HeightRequest="150">
                        <BoxView
                            BackgroundColor="#8bc34a"
                            WidthRequest="150"
                            HeightRequest="150"
                            CornerRadius="75"
                            AbsoluteLayout.LayoutBounds="0.5, 0.5, 150, 150"
                            AbsoluteLayout.LayoutFlags="PositionProportional" />
                        <Label
                            x:Name="Labelinitials"
                            TextColor="White"
                            FontSize="50"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            AbsoluteLayout.LayoutBounds="0.5, 0.5, 150, 150"
                            AbsoluteLayout.LayoutFlags="PositionProportional" />
                    </AbsoluteLayout>
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Imię" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryName"
                            Placeholder="Podaj imię"/>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Nazwisko" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntrySurname"
                            Placeholder="Podaj nazwisko"/>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Data urodzenia" />
                    <Border Style="{StaticResource BorderEntry}">
                        <DatePicker
                            Style="{StaticResource DatePickerForm}"
                            x:Name="DatePickerDateOfBirth"/>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Adres e-mail" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Placeholder="Podaj adres e-mail"/>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Numer telefonu" />
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPhoneNumber"
                            Placeholder="Podaj numer telefonu"/>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToMenuPage"
                        Text="Zmień"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>