<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.RegisterPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zarejestruj się" />

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Imię"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryName"
                            Keyboard="Text"
                            Placeholder="Podaj imię"
                            Text="{Binding Item.Name}" />
                    </Border>
                    
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Nazwisko"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntrySurname"
                            Keyboard="Text"
                            Placeholder="Podaj nazwisko"
                            Text="{Binding Item.Surname}" />
                    </Border>
                    
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Data urodzenia"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <DatePicker
                            Style="{StaticResource DatePickerForm}"
                            x:Name="DatePickerDateOfBirth"
                            Date="{Binding Item.DateOfBirth}" />
                    </Border>
                    
                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Email"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Keyboard="Email"
                            Placeholder="Podaj adres e-mail"
                            Text="{Binding Item.Email}" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Numer telefonu"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPhoneNumber"
                            Keyboard="Telephone"
                            Placeholder="Podaj numer telefonu"
                            Text="{Binding Item.PhoneNumber}" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Saldo konta"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryAccountBalance"
                            Keyboard="Numeric"
                            Placeholder="Podaj saldo konta"
                            Text="{Binding Item.AccountBalance}" />
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryPassword"
                                Keyboard="Text"
                                Placeholder="Podaj hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill"
                                Text="{Binding Item.Password}" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityPassword"
                                Clicked="OnButtonChangeVisibilityPasswordClicked" />
                        </Grid>
                    </Border>

                    <Label
                        Style="{StaticResource LabelFormMini}"
                        Text="Powtórzone hasło"/>
                    <Border Style="{StaticResource BorderEntry}">
                        <Grid ColumnDefinitions="*, 50">
                            <Entry
                                Grid.Column="0"
                                Style="{StaticResource EntryForm}"
                                x:Name="EntryRepeatedPassword"
                                Keyboard="Text"
                                Placeholder="Powtórz hasło"
                                IsPassword="True"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource ButtonChangeVisibilityPassword}"
                                x:Name="ButtonChangeVisibilityRepeatedPassword"
                                Clicked="OnButtonChangeVisibilityRepeatedPasswordClicked" />
                        </Grid>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        x:Name="ButtonGoToLoginPage"
                        Text="Zarejestruj"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToLoginPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>