<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MainPage">

    <ScrollView>
        <VerticalStackLayout
            BackgroundColor="#0B0F14"
            Spacing="20"
            Padding="15">
            
            <Label
                Text="Zaloguj się"
                FontAttributes="Bold"
                FontSize="20"
                FontFamily="Arial"
                TextColor="White"
                BackgroundColor="DarkGray"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                Padding="15"
                Margin="0, 0, 0, 70"></Label>
            <Entry Keyboard="Text" 
                   Placeholder="Podaj login" 
                   VerticalTextAlignment="Center" 
                   HorizontalTextAlignment="Center"
                   BackgroundColor="Gray"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontFamily="Arial"
                   FontSize="15"></Entry>
            <Entry Keyboard="Password" 
                   Placeholder="Podaj hasło" 
                   VerticalTextAlignment="Center" 
                   HorizontalTextAlignment="Center"
                   BackgroundColor="Gray"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontFamily="Arial"
                   FontSize="15"></Entry>
            <Button
                Text="Zaloguj"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontAttributes="Bold"
                FontFamily="Arial"
                FontSize="25"
                BackgroundColor="Gray"></Button>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
