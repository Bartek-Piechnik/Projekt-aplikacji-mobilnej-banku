<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MainViewPage"
             NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout BackgroundColor="#dedede">
            <VerticalStackLayout>
                <Grid
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Margin="10, 5, 10, 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Button
                        Style="{StaticResource Button}"
                        Grid.Column="0"
                        Grid.Row="0"
                        ImageSource="logout.png"
                        HeightRequest="50"
                        WidthRequest="120"
                        HorizontalOptions="Start"
                        Clicked="OnButtonLogOutClicked" />
                    <Button
                        Style="{StaticResource Button}"
                        Grid.Column="1"
                        Grid.Row="0"
                        ImageSource="menu.png"
                        HeightRequest="50"
                        WidthRequest="120"
                        HorizontalOptions="End"
                        Clicked="OnButtonGoToMenuPageClicked" />
                </Grid>

                <AbsoluteLayout
                    Margin="15"
                    HeightRequest="200">
                    <BoxView
                        BackgroundColor="#8bc34a"
                        CornerRadius="20"
                        AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                        AbsoluteLayout.LayoutFlags="All" />
                    <Label
                        Text="Rachunek bieżący"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.03, 220, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="01 2345 6789 1011 1213 1415 1617"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.2, 0.22, 300, 20"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="Dostępne środki"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.5, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="1 000,00 PLN"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.1, 0.67, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="Saldo"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.8, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Label
                        Text="1 500,00 PLN"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.1, 0.94, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                    <Image
                        Source="appiconfg.svg"
                        WidthRequest="140"
                        HeightRequest="140"
                        AbsoluteLayout.LayoutBounds="0.95, 0.95, 140, 140"
                        AbsoluteLayout.LayoutFlags="PositionProportional" />
                </AbsoluteLayout>
            </VerticalStackLayout>

            <ScrollView>
                <Border
                    Style="{StaticResource BorderWhiteSection}"
                    Margin="10, 0, 10, 0"
                    StrokeThickness="0">
                    <VerticalStackLayout BackgroundColor="White">
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="Ostatnie transakcje"
                            FontSize="30"
                            VerticalTextAlignment="Start"
                            HorizontalTextAlignment="Center" />

                        <AbsoluteLayout
                            Margin="15"
                            HeightRequest="300">
                            <Label
                                Text="Wtorek 29.09.2026"
                                TextColor="Gray"
                                FontSize="18"
                                FontAttributes="Italic"
                                FontFamily="Arial"
                                Margin="0, 0, 0, 0.5"
                                AbsoluteLayout.LayoutBounds="0.05, 0.01, 230, 25"
                                AbsoluteLayout.LayoutFlags="PositionProportional" />
                            <BoxView
                                BackgroundColor="#888888"
                                HeightRequest="100"
                                CornerRadius="20"
                                AbsoluteLayout.LayoutBounds="0, 0.16, 1, 0.28"
                                AbsoluteLayout.LayoutFlags="All" />
                            <Label
                                Text="Wpłata"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                AbsoluteLayout.LayoutBounds="0.05, 0.15, 170, 35"
                                AbsoluteLayout.LayoutFlags="PositionProportional" />
                            <Label
                                Text="Tytuł wpłaty"
                                TextColor="White"
                                FontSize="18"
                                AbsoluteLayout.LayoutBounds="0.2, 0.26, 300, 35"
                                AbsoluteLayout.LayoutFlags="PositionProportional" />
                            <Label
                                Text="+100,00 PLN"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                AbsoluteLayout.LayoutBounds="0.96, 0.15, 130, 20"
                                AbsoluteLayout.LayoutFlags="PositionProportional" />
                            <BoxView
                                BackgroundColor="Black"
                                HeightRequest="1"
                                AbsoluteLayout.LayoutBounds="0, 0.45, 1, 0.28"
                                AbsoluteLayout.LayoutFlags="All" />
                        </AbsoluteLayout>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>

            <Border
                Style="{StaticResource BorderWhiteSection}"
                Margin="10, 20, 10, 20"
                StrokeThickness="0">
                <VerticalStackLayout BackgroundColor="White">
                    <Label
                        Style="{StaticResource LabelForm}"
                        Text="Opcje przelewu"
                        FontSize="20"
                        HorizontalTextAlignment="Center">
                    </Label>
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10"
                        Margin="0, 5, 0, 10">
                        <Button
                            Style="{StaticResource Button}"
                            Text="BLIK"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionBLIKClicked" />
                        <Button
                            Style="{StaticResource Button}"
                            Text="Krajowy"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionDomesticClicked" />
                        <Button
                            Style="{StaticResource Button}"
                            Text="Telefon"
                            FontSize="18"
                            HeightRequest="75"
                            WidthRequest="120"
                            Clicked="OnButtonGoToTransferOptionPhoneClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>