<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MainViewPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        
        <ScrollView Grid.Row="0">
            <AbsoluteLayout Margin="15" HeightRequest="800">
                <BoxView
                    BackgroundColor="LightSlateGrey"
                    CornerRadius="20"
                    AbsoluteLayout.LayoutBounds="0, 0, 1, 0.28"
                    AbsoluteLayout.LayoutFlags="All"/>
                <Label
                    Text="Rachunek bieżący"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.05, 0.03, 170, 35"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
                <Label
                    Text="01 2345 6789 1011 1213 1415 1617"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.1, 0.08, 300, 20"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
                <Label
                    Text="Dostępne środki"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.05, 0.13, 170, 35"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
                <Label
                    Text="1 000,00 PLN"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.1, 0.17, 170, 35"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
                <Label
                    Text="Saldo"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.05, 0.2, 170, 35"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
                <Label
                    Text="1 500,00 PLN"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    AbsoluteLayout.LayoutBounds="0.1, 0.24, 170, 35"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
            </AbsoluteLayout>
        </ScrollView>
        
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Label
                    Text="Ostatnie transakcje"
                    TextColor="Black"
                    FontSize="30"
                    FontAttributes="Bold"
                    FontFamily="Arial"
                    VerticalTextAlignment="Start"
                    HorizontalTextAlignment="Center"></Label>
                <AbsoluteLayout Margin="15" HeightRequest="300">
                    <Label
                        Text="Niedziela 27.09.2026"
                        TextColor="Gray"
                        FontSize="18"
                        FontAttributes="Italic"
                        FontFamily="Arial"
                        Margin="0, 0, 0, 0.5"
                        AbsoluteLayout.LayoutBounds="0.05, 0.01, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional"></Label>
                    <BoxView
                        BackgroundColor="Black"
                        HeightRequest="100"
                        CornerRadius="20"
                        AbsoluteLayout.LayoutBounds="0, 0.16, 1, 0.28"
                        AbsoluteLayout.LayoutFlags="All"/>
                    <Label
                        Text="Wpłata"
                        TextColor="White"
                        FontSize="20"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.05, 0.15, 170, 35"
                        AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    <Label
                        Text="+100,00 PLN"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        AbsoluteLayout.LayoutBounds="0.1, 0.27, 130, 20"
                        AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    <BoxView
                        BackgroundColor="Black"
                        HeightRequest="1"
                        AbsoluteLayout.LayoutBounds="0, 0.45, 1, 0.28"
                        AbsoluteLayout.LayoutFlags="All"/>
                </AbsoluteLayout>
            </VerticalStackLayout>
        </ScrollView>
        
        <VerticalStackLayout Grid.Row="2">
            <Label
                Text="Opcje przelewu"
                TextColor="Black"
                FontSize="20"
                FontAttributes="Bold"
                FontFamily="Arial"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"></Label>
        </VerticalStackLayout>
        
        <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="5" Margin="0, 5, 0, 0">
            <Button
                Text="BLIK"
                TextColor="White"
                FontSize="18"
                FontFamily="Arial"
                BackgroundColor="Black"
                HeightRequest="75"
                WidthRequest="130"
                CornerRadius="20"></Button>
            <Button
                Text="Krajowy"
                TextColor="White"
                FontSize="18"
                FontFamily="Arial"
                BackgroundColor="Black"
                HeightRequest="75"
                WidthRequest="130"
                CornerRadius="20"></Button>
            <Button
                Text="Telefon"
                TextColor="White"
                FontSize="18"
                FontFamily="Arial"
                BackgroundColor="Black"
                HeightRequest="75"
                WidthRequest="130"
                CornerRadius="20"></Button>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>