<?xml version="1.0" encoding="UTF-8"?>

<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Aplikacja_bankowa"
             x:Class="Aplikacja_bankowa.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="VerticalStackLayout" TargetType="VerticalStackLayout">
                <Setter Property="BackgroundColor" Value="Green" />
                <Setter Property="Spacing" Value="20" />
                <Setter Property="Padding" Value="15" />
            </Style>

            <Style x:Key="VerticalStackLayoutWhiteSection" TargetType="VerticalStackLayout">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Spacing" Value="20" />
                <Setter Property="Padding" Value="15" />
            </Style>
            
            <Style x:Key="BorderWhiteSection" TargetType="Border">
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="25" />
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style x:Key="BorderEntry" TargetType="Border">
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BackgroundColor" Value="#cdcdcd"></Setter>
            </Style>
            
            <Style x:Key="LabelHeader" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="35" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Padding" Value="15" />
            </Style>

            <Style x:Key="LabelForm" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold"></Setter>
                <Setter Property="FontSize" Value="25"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="TextColor" Value="Black"></Setter>
                <Setter Property="VerticalTextAlignment" Value="Center"></Setter>
            </Style>

            <Style x:Key="EntryForm" TargetType="Entry">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="PlaceholderColor" Value="#444444" />
            </Style>

            <Style x:Key="Button" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold"></Setter>
                <Setter Property="FontSize" Value="25"></Setter>
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="TextColor" Value="White"></Setter>
                <Setter Property="BackgroundColor" Value="Green"></Setter>
                <Setter Property="VerticalOptions" Value="Center"></Setter>
                <Setter Property="CornerRadius" Value="20"></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>