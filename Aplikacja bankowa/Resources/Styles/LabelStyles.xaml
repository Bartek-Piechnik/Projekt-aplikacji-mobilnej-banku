<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Style x:Key="LabelHeader" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="35" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="TextColor" Value="#f2f9f1" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <Style x:Key="LabelForm" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="25"></Setter>
        <Setter Property="FontFamily" Value="Arial"></Setter>
        <Setter Property="TextColor" Value="Black"></Setter>
        <Setter Property="VerticalTextAlignment" Value="Center"></Setter>
    </Style>

    <Style x:Key="LabelFormMini" TargetType="Label" BasedOn="{StaticResource LabelForm}">
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="HorizontalTextAlignment" Value="Start"></Setter>
        <Setter Property="Padding" Value="15"></Setter>
    </Style>
</ResourceDictionary>