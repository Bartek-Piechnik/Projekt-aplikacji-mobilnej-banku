<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="EntryForm" TargetType="Entry">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="PlaceholderColor" Value="#444444" />
    </Style>

    <Style x:Key="DatePickerForm" TargetType="DatePicker">
        <Setter Property="FontAttributes" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="FontFamily" Value="Arial"></Setter>
        <Setter Property="TextColor" Value="Black"></Setter>
        <Setter Property="BackgroundColor" Value="#ddeedf"></Setter>
        <Setter Property="VerticalOptions" Value="Center"></Setter>
        <Setter Property="HorizontalOptions" Value="Center"></Setter>
        <Setter Property="Format" Value="dd.MM.yyyy"></Setter>
    </Style>

    <Style x:Key="Button" TargetType="Button">
        <Setter Property="FontAttributes" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="25"></Setter>
        <Setter Property="FontFamily" Value="Arial"></Setter>
        <Setter Property="TextColor" Value="#f2f9f1"></Setter>
        <Setter Property="BackgroundColor" Value="#388e3c"></Setter>
        <Setter Property="VerticalOptions" Value="Center"></Setter>
        <Setter Property="CornerRadius" Value="20"></Setter>
    </Style>

    <Style x:Key="ButtonChangeVisibilityPassword" TargetType="Button" BasedOn="{StaticResource Button}">
        <Setter Property="ImageSource" Value="password_visibility_off.png"></Setter>
        <Setter Property="HeightRequest" Value="45"></Setter>
        <Setter Property="WidthRequest" Value="45"></Setter>
        <Setter Property="HorizontalOptions" Value="End"></Setter>
    </Style>
</ResourceDictionary>