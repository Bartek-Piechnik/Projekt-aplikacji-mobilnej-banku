<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.MyDataPage">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Border Style="{StaticResource WhiteSectionBorder}"
                    Background="#cdcdcd">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}"
                                     Padding="5">
                    <VerticalStackLayout>
                        <Label
                            Text="Imię"
                            HorizontalTextAlignment="Center"
                            Padding="15"
                            Style="{StaticResource LabelForm}" />
                        <Border Style="{StaticResource WhiteSectionBorder}">
                            <HorizontalStackLayout BackgroundColor="#cdcdcd">
                                <Entry
                                    x:Name="EntryName"
                                    Text=""
                                    Placeholder=""
                                    Style="{StaticResource EntryForm2}" />
                                <Button
                                    Text="Zmień"
                                    Style="{StaticResource ButtonGreen}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Text="Nazwisko"
                            HorizontalTextAlignment="Center"
                            Padding="15"
                            Style="{StaticResource LabelForm}" />
                        <Border Style="{StaticResource WhiteSectionBorder}">
                            <HorizontalStackLayout BackgroundColor="#cdcdcd">
                                <Entry
                                    x:Name="EntrySurname"
                                    Text=""
                                    Placeholder=""
                                    Style="{StaticResource EntryForm2}" />
                                <Button
                                    Text="Zmień"
                                    Style="{StaticResource ButtonGreen}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Text="Data urodzenia"
                            HorizontalTextAlignment="Center"
                            Padding="15"
                            Style="{StaticResource LabelForm}" />
                        <Border Style="{StaticResource WhiteSectionBorder}">
                            <VerticalStackLayout BackgroundColor="#cdcdcd">
                                <DatePicker
                                    x:Name="DatePickerDateOfBirth"
                                    Format="dd.MM.yyyy"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#cdcdcd"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    FontFamily="Arial"
                                    FontSize="15" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Text="Adres e-mail"
                            HorizontalTextAlignment="Center"
                            Padding="15"
                            Style="{StaticResource LabelForm}" />
                        <Border Style="{StaticResource WhiteSectionBorder}">
                            <HorizontalStackLayout BackgroundColor="#cdcdcd">
                                <Entry
                                    x:Name="EntryEmail"
                                    Text=""
                                    Placeholder=""
                                    Style="{StaticResource EntryForm2}" />
                                <Button
                                    Text="Zmień"
                                    Style="{StaticResource ButtonGreen}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label
                            Text="Numer telefonu"
                            HorizontalTextAlignment="Center"
                            Padding="15"
                            Style="{StaticResource LabelForm}" />
                        <Border Style="{StaticResource WhiteSectionBorder}">
                            <HorizontalStackLayout BackgroundColor="#cdcdcd">
                                <Entry
                                    x:Name="EntryPhoneNumber"
                                    Text=""
                                    Placeholder=""
                                    Style="{StaticResource EntryForm2}" />
                                <Button
                                    Text="Zmień"
                                    Style="{StaticResource ButtonGreen}" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>