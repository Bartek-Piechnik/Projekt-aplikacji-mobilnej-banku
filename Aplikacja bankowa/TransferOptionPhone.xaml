<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionPhone">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Przelew BLIK na telefon"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}">
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryRecipientsPhoneNumber"
                            Keyboard="Telephone"
                            Placeholder="Podaj numer telefonu odbiorcy"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryRecipientNameAndSurname"
                            Keyboard="Text"
                            Placeholder="Podaj imię i nazwisko odbiorcy"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryTransferReference"
                            Keyboard="Text"
                            Placeholder="Podaj tytuł przelewu"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Entry
                            x:Name="EntryTransferAmount"
                            Keyboard="Numeric"
                            Placeholder="Podaj kwotę przelewu"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Button
                        Text="Przelej"
                        HorizontalOptions="Center"
                        FontSize="25"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonTransferClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>