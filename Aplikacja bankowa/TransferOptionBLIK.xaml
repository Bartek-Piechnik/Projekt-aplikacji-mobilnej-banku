<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionBLIK">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Kod BLIK"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}">
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#eeeeee">
                        <Label
                            Text="123 456"
                            FontAttributes="Bold"
                            FontSize="30"
                            FontFamily="Arial"
                            TextColor="Black"
                            Padding="10"
                            HorizontalOptions="Center" />
                    </Border>

                    <Button
                        Text="Skopiuj kod"
                        HorizontalOptions="Center"
                        FontSize="25"
                        Style="{StaticResource ButtonGreen}"
                        Clicked="OnButtonCopyCodeClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>