<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionBLIK"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Kod BLIK"/>

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Border Style="{StaticResource BorderEntry}">
                        <Label
                            Style="{StaticResource LabelForm}"
                            Text="123 456"
                            FontSize="30"
                            Padding="10"
                            HorizontalOptions="Center"/>
                    </Border>

                    <Button
                        Style="{StaticResource Button}"
                        Text="Skopiuj kod"
                        HorizontalOptions="Center"
                        FontSize="25"
                        Clicked="OnButtonCopyCodeClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>