<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.TransferOptionBLIK">

    <ScrollView>
        <VerticalStackLayout
            BackgroundColor="Green"
            Spacing="20"
            Padding="15">
            <Label
                Text="Kod BLIK"
                FontAttributes="Bold"
                FontSize="35"
                FontFamily="Arial"
                TextColor="White"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center" />

            <Border>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"></RoundRectangle>
                </Border.StrokeShape>
                <VerticalStackLayout
                    BackgroundColor="White"
                    VerticalOptions="Center"
                    Padding="15"
                    Spacing="20">
                    <Border BackgroundColor="#eeeeee">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Label
                            Text="123 456"
                            FontAttributes="Bold"
                            FontSize="30"
                            FontFamily="Arial"
                            TextColor="Black"
                            Padding="10"
                            HorizontalOptions="Center" />
                    </Border>

                    <Button
                        Text="Skopiuj kod"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        FontAttributes="Bold"
                        FontFamily="Arial"
                        FontSize="25"
                        BackgroundColor="Green"
                        TextColor="White"
                        CornerRadius="20"
                        Clicked="OnButtonCopyCodeClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>