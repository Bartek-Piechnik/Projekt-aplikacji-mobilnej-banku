<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.RegisterPage"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayout}">
            <Label
                Style="{StaticResource LabelHeader}"
                Text="Zarejestruj się"/>

            <Border Style="{StaticResource BorderWhiteSection}">
                <VerticalStackLayout Style="{StaticResource VerticalStackLayoutWhiteSection}">
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryName"
                            Keyboard="Text"
                            Placeholder="Podaj imię"/>
                    </Border>
                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntrySurname"
                            Keyboard="Text"
                            Placeholder="Podaj nazwisko"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <VerticalStackLayout>
                            <Label
                                Style="{StaticResource LabelForm}"
                                Text="Podaj datę urodzenia"
                                HorizontalTextAlignment="Center"
                                FontSize="15"/>
                            <DatePicker
                                x:Name="DatePickerDateOfBirth"
                                Format="dd.MM.yyyy"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                BackgroundColor="#cdcdcd"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryEmail"
                            Keyboard="Email"
                            Placeholder="Podaj adres e-mail"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPhoneNumber"
                            Keyboard="Telephone"
                            Placeholder="Podaj numer telefonu"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryAccountBalance"
                            Keyboard="Numeric"
                            Placeholder="Podaj saldo konta"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryPassword"
                            Keyboard="Password"
                            Placeholder="Podaj hasło"/>
                    </Border>

                    <Border Style="{StaticResource BorderEntry}">
                        <Entry
                            Style="{StaticResource EntryForm}"
                            x:Name="EntryRepeatedPassword"
                            Keyboard="Password"
                            Placeholder="Powtórz hasło"/>
                    </Border>
                    <Button
                        Style="{StaticResource Button}"
                        Text="Zarejestruj"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToLoginPageClicked"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>