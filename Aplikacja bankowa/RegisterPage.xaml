<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.RegisterPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="15"
            BackgroundColor="Green">

            <Label
                Text="Zarejestruj się"
                FontAttributes="Bold"
                FontSize="30"
                FontFamily="Arial"
                TextColor="White"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                Padding="15" />

            <Border>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"></RoundRectangle>
                </Border.StrokeShape>
                <VerticalStackLayout
                        BackgroundColor="White"
                        VerticalOptions="Center"
                        Padding="15"
                        Spacing="15">
                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Text" 
                       Placeholder="Podaj imię" 
                       VerticalTextAlignment="Center" 
                       HorizontalTextAlignment="Center"
                       PlaceholderColor="#444444"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontFamily="Arial"
                       FontSize="15" />
                    </Border>
                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Text" 
                               Placeholder="Podaj nazwisko" 
                               VerticalTextAlignment="Center" 
                               HorizontalTextAlignment="Center"
                               PlaceholderColor="#444444"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontFamily="Arial"
                               FontSize="15"/>
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label
                                Text="Podaj datę urodzenia"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                            <DatePicker
                                Format="dd.MM.yyyy"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                BackgroundColor="#cdcdcd"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Email" 
                               Placeholder="Podaj adres e-mail" 
                               VerticalTextAlignment="Center" 
                               HorizontalTextAlignment="Center"
                               PlaceholderColor="#444444"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontFamily="Arial"
                               FontSize="15" />
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Telephone" 
                       Placeholder="Podaj numer telefonu" 
                       VerticalTextAlignment="Center" 
                       HorizontalTextAlignment="Center"
                       PlaceholderColor="#444444"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontFamily="Arial"
                       FontSize="15" />
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Numeric" 
                       Placeholder="Podaj saldo konta" 
                       VerticalTextAlignment="Center" 
                       HorizontalTextAlignment="Center"
                       PlaceholderColor="#444444"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontFamily="Arial"
                       FontSize="15" />
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Text" 
                               Placeholder="Podaj login" 
                               VerticalTextAlignment="Center" 
                               HorizontalTextAlignment="Center"
                               PlaceholderColor="#444444"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontFamily="Arial"
                               FontSize="15" />
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Password" 
                               Placeholder="Podaj hasło" 
                               VerticalTextAlignment="Center" 
                               HorizontalTextAlignment="Center"
                               PlaceholderColor="#444444"
                                TextColor="Black"
                               FontAttributes="Bold"
                               FontFamily="Arial"
                               FontSize="15" />
                    </Border>

                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry Keyboard="Password" 
                               Placeholder="Powtórz hasło" 
                               VerticalTextAlignment="Center" 
                               HorizontalTextAlignment="Center"
                               PlaceholderColor="#444444"
                               TextColor="Black"
                               FontAttributes="Bold"
                               FontFamily="Arial"
                               FontSize="15" />
                    </Border>
                    <Button
                        Text="Zarejestruj"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        FontFamily="Arial"
                        FontSize="25"
                        TextColor="White"
                        BackgroundColor="Green"
                        CornerRadius="20"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToLoginPageClicked" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>