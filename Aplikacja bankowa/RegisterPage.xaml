<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.RegisterPage">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Zarejestruj się"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}">
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryName"
                            Keyboard="Text"
                            Placeholder="Podaj imię"
                            Style="{StaticResource EntryForm}" />
                    </Border>
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntrySurname"
                            Keyboard="Text"
                            Placeholder="Podaj nazwisko"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <VerticalStackLayout>
                            <Label
                                Text="Podaj datę urodzenia"
                                VerticalTextAlignment="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                            <DatePicker
                                x:Name="DatePickerDateOfBirth"
                                Format="dd.MM.yyyy"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                BackgroundColor="#cdcdcd"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontFamily="Arial"
                                FontSize="15" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryEmail"
                            Keyboard="Email"
                            Placeholder="Podaj adres e-mail"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryPhoneNumber"
                            Keyboard="Telephone"
                            Placeholder="Podaj numer telefonu"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryAccountBalance"
                            Keyboard="Numeric"
                            Placeholder="Podaj saldo konta"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryLogin"
                            Keyboard="Text"
                            Placeholder="Podaj login"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryPassword"
                            Keyboard="Password"
                            Placeholder="Podaj hasło"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryRepeatedPassword"
                            Keyboard="Password"
                            Placeholder="Powtórz hasło"
                            Style="{StaticResource EntryForm}" />
                    </Border>
                    <Button
                        Text="Zarejestruj"
                        Style="{StaticResource ButtonGreen}"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToLoginPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>