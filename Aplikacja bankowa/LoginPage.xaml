<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.LoginPage"
             NavigationPage.HasBackButton="False">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource VerticalStackLayoutBackground}">
            <Label
                Text="Zaloguj się"
                Style="{StaticResource LabelHeader}" />

            <Border Style="{StaticResource WhiteSectionBorder}">
                <VerticalStackLayout Style="{StaticResource WhiteSectionVerticalStackLayoutBackground}">
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            BackgroundColor="#cdcdcd">
                        <Entry
                            x:Name="EntryLogin"
                            Keyboard="Text"
                            Placeholder="Podaj login"
                            Style="{StaticResource EntryForm}" />
                    </Border>
                    <Border Style="{StaticResource WhiteSectionBorder}"
                            Background="#cdcdcd">
                        <Entry
                            x:Name="EntryPassword"
                            Keyboard="Password"
                            Placeholder="Podaj hasło"
                            Style="{StaticResource EntryForm}" />
                    </Border>

                    <Button
                        Text="Zaloguj"
                        Style="{StaticResource ButtonGreen}"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMainViewPageClicked" />
                    <Button
                        Text="Nie masz konta ? Zarejestruj się"
                        HorizontalOptions="End"
                        FontAttributes="Italic"
                        FontFamily="Arial"
                        FontSize="12"
                        TextColor="Green"
                        BackgroundColor="Transparent"
                        Clicked="OnButtonGoToRegisterPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>