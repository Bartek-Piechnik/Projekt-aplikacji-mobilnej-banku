<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.LoginPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="15">
            
            <Border Background="DarkGray" 
                    Margin="0, 50, 0, 75">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"></RoundRectangle>
                </Border.StrokeShape>
                <Label
                    Text="Zaloguj się"
                    FontAttributes="Bold"
                    FontSize="30"
                    FontFamily="Arial"
                    TextColor="White"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Padding="15"></Label>
            </Border>
            
            <Border Background="Gray">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                </Border.StrokeShape>
                <Entry Keyboard="Text" 
                       Placeholder="Podaj login" 
                       VerticalTextAlignment="Center" 
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontFamily="Arial"
                       FontSize="15"></Entry>
            </Border>
            
            <Border Background="Gray">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                </Border.StrokeShape>
                <Entry Keyboard="Password" 
                       Placeholder="Podaj hasło" 
                       VerticalTextAlignment="Center" 
                       HorizontalTextAlignment="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontFamily="Arial"
                       FontSize="15"></Entry>
            </Border>

            <Button
                Text="Zaloguj"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontAttributes="Bold"
                FontFamily="Arial"
                FontSize="25"
                BackgroundColor="Gray"
                CornerRadius="20"
                Margin="0, 50, 0, 50"
                Clicked="OnButtonGoToMainViewPageClicked"></Button>
            
            <Button
                Text="Nie masz konta ? Zarejestruj się"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                FontAttributes="Italic"
                FontFamily="Arial"
                FontSize="20"
                TextColor="White"
                BackgroundColor="Gray"
                CornerRadius="20"
                Padding="15"
                Clicked="OnButtonGoToRegisterPageClicked"></Button>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>