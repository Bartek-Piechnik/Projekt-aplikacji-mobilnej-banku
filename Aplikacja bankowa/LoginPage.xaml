<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aplikacja_bankowa.LoginPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="15"
            BackgroundColor="Green">

            <Label 
                Text="Zaloguj się"
                FontAttributes="Bold"
                FontSize="35"
                FontFamily="Arial"
                TextColor="White"
                VerticalTextAlignment="Center"
                HorizontalTextAlignment="Center"
                Padding="15" />

            <Border>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25"></RoundRectangle>
                </Border.StrokeShape>
                <VerticalStackLayout
                    BackgroundColor="White"
                    VerticalOptions="Center"
                    Padding="15"
                    Spacing="20">
                    <Border BackgroundColor="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry 
                            x:Name="EntryLogin"
                            Keyboard="Text" 
                            Placeholder="Podaj login" 
                            VerticalTextAlignment="Center" 
                            HorizontalTextAlignment="Center"
                            TextColor="Black"
                            PlaceholderColor="#444444"
                            FontAttributes="Bold"
                            FontFamily="Arial"
                            FontSize="15"/>
                    </Border>
                    <Border Background="#cdcdcd">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <Entry 
                            x:Name="EntryPassword"
                            Keyboard="Password" 
                            Placeholder="Podaj hasło" 
                            VerticalTextAlignment="Center" 
                            HorizontalTextAlignment="Center"
                            TextColor="Black"
                            PlaceholderColor="#444444"
                            FontAttributes="Bold"
                            FontFamily="Arial"
                            FontSize="15"/>
                    </Border>

                    <Button 
                        Text="Zaloguj"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        FontFamily="Arial"
                        FontSize="25"
                        BackgroundColor="Green"
                        TextColor="White"
                        CornerRadius="20"
                        Margin="15, 20, 15, 0"
                        Clicked="OnButtonGoToMainViewPageClicked"/>
                    <Button
                        Text="Nie masz konta ? Zarejestruj się"
                        HorizontalOptions="End"
                        FontAttributes="Italic"
                        FontFamily="Arial"
                        FontSize="12"
                        TextColor="Green"
                        BackgroundColor="Transparent"
                        Clicked="OnButtonGoToRegisterPageClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>